{
  "name": "spire-of-ash-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser client for Spire of Ash. Built output is committed to spire_of_ash/web/static so players need no toolchain.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "gsap": "^3.13.0"
  }
}
